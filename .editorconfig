root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

[*.py]
charset = utf-8
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx}]
charset = utf-8
indent_style = space
indent_size = 2

[*.{md,txt}]
charset = utf-8
indent_style = space
indent_size = 2

[*.{json,toml,yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2

[*.{css,html}]
charset = utf-8
indent_style = space
indent_size = 2

[*.ps1]
charset = utf-8
indent_style = space
indent_size = 2
