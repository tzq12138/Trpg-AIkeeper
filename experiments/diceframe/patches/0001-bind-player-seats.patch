--- a/src/webui/session.py
+++ b/src/webui/session.py
@@ -69,6 +69,23 @@ class SessionManager:
             self._sessions[token]["user_id"] = user_id
             self._save()
 
+    def game_user_id(self, token: str, game_key: str) -> str:
+        """<summary>Resolve this session's seat without replacing identities in other games.</summary>
+        <param name="token">Existing browser session.</param><param name="game_key">Game identifier.</param>
+        <returns>The saved game seat, or the legacy session identity.</returns>
+        """
+        session = self._sessions.get(token, {})
+        return session.get("game_users", {}).get(game_key, session.get("user_id", ""))
+
+    def rebind_game(self, token: str, game_key: str, user_id: str) -> None:
+        """<summary>Persist a claimed seat only for its game.</summary>
+        <param name="token">Existing browser session.</param><param name="game_key">Game identifier.</param>
+        <param name="user_id">Authorized seat identity.</param><returns>Nothing.</returns>
+        """
+        if token in self._sessions:
+            self._sessions[token].setdefault("game_users", {})[game_key] = user_id
+            self._save()
+
 
